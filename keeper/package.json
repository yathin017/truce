{
  "name": "@reservoir/keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "reservoir-keeper": "src/index.ts"
  },
  "exports": {
    "./executor": { "types": "./src/executor.ts", "default": "./src/executor.ts" },
    "./artifacts": { "types": "./src/artifacts.ts", "default": "./src/artifacts.ts" },
    "./clients": { "types": "./src/clients.ts", "default": "./src/clients.ts" },
    "./coordinator": { "types": "./src/coordinator.ts", "default": "./src/coordinator.ts" },
    "./log": { "types": "./src/log.ts", "default": "./src/log.ts" }
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@reservoir/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "viem": "^2.21.55",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
